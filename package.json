{
  "name": "evolv-local-ai",
  "productName": "Evolv",
  "version": "0.6.3",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "config": {
    "forge": "./forge.config.cjs"
  },
  "description": "A local-first, Ollama-powered chat that improves through explicit feedback and reversible prompt upgrades.",
  "repository": {
    "type": "git",
    "url": "https://github.com/WI7ARD/evolv-personal.git"
  },
  "homepage": "https://github.com/WI7ARD/evolv-personal",
  "bugs": {
    "url": "https://github.com/WI7ARD/evolv-personal/issues"
  },
  "scripts": {
    "postinstall": "node scripts/patch-extract-zip.mjs && node scripts/repair-electron.mjs",
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "desktop": "electron-forge start",
    "package:win": "electron-forge package --platform=win32 --arch=x64",
    "make:win": "electron-forge make --platform=win32 --arch=x64",
    "dist:win": "node scripts/pack-win.mjs",
    "package:linux": "electron-forge package --platform=linux --arch=x64",
    "make:linux": "electron-forge make --platform=linux --arch=x64",
    "dist:linux": "node scripts/pack-win.mjs --platform=linux",
    "installer:win": "node scripts/make-installers.mjs --platform=win32",
    "installer:linux": "node scripts/make-installers.mjs --platform=linux",
    "linux:validate": "node scripts/validate-linux.mjs",
    "itch:validate": "node scripts/itch-release.mjs validate",
    "itch:push": "node scripts/itch-release.mjs push",
    "itch:validate:linux": "node scripts/itch-release.mjs validate linux",
    "itch:push:linux": "node scripts/itch-release.mjs push linux",
    "test": "node scripts/run-tests.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:persisted": "node scripts/persisted-smoke.mjs",
    "smoke:models": "node scripts/models-smoke.mjs",
    "pack:validate": "node scripts/evolv-pack.mjs validate",
    "pack:build": "node scripts/evolv-pack.mjs build",
    "pack:watch": "node scripts/evolv-pack.mjs watch",
    "sign:status:win": "node scripts/windows-signing.mjs status",
    "sign:win": "node scripts/windows-signing.mjs sign",
    "sign:verify:win": "node scripts/windows-signing.mjs verify",
    "release:gate:win": "node scripts/windows-signing.mjs gate",
    "release:stage7:check": "node scripts/release-stage7.mjs --check-only",
    "release:stage7": "node scripts/release-stage7.mjs"
  },
  "engines": {
    "node": ">=20.3"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "better-sqlite3": "12.9.0",
    "matter-js": "^0.20.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "electron": "41.10.4",
    "esbuild": "^0.28.1"
  },
  "overrides": {
    "tar": "7.5.22",
    "tmp": "0.2.7"
  }
}
